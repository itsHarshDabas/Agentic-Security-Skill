#!/bin/sh
# Entry point for the security-audit skill. Runs the bundled engine with an
# isolated interpreter (-I) so files in the audited project's directory can
# never shadow engine modules.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY=${SECAUDIT_PYTHON:-python3}
exec "$PY" -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from secaudit.cli import main; sys.exit(main(sys.argv[2:]))' "$here/../lib" "$@"
